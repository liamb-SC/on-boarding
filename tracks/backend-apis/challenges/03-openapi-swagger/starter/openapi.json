{
  "openapi": "3.0.3",
  "info": {
    "title": "Books API",
    "version": "1.0.0"
  },
  "paths": {
    "/books": {
      "get": {
        "summary": "List books",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "The books",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Book" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "required": ["id", "title", "author"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" }
        }
      }
    }
  }
}
